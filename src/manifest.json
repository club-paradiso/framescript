{
  "manifest_version": 3,
  "name": "FrameScript",
  "version": "0.1.0",
  "description": "Watch at the best quality. Understand it like a screenplay.",
  "minimum_chrome_version": "116",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "FrameScript",
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background/serviceWorker.js",
    "type": "module"
  },
  "side_panel": {
    "default_path": "sidepanel/index.html"
  },
  "options_page": "options/index.html",
  "permissions": ["storage", "sidePanel", "tabCapture", "offscreen", "scripting", "activeTab", "unlimitedStorage"],
  "host_permissions": ["https://www.youtube.com/*", "https://www.netflix.com/*"],
  "content_scripts": [
    {
      "matches": ["https://www.youtube.com/*", "https://www.netflix.com/*"],
      "js": ["content/entry.js"],
      "run_at": "document_idle",
      "all_frames": false
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["content/mainWorldBridge.js"],
      "matches": ["https://www.youtube.com/*", "https://www.netflix.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}
