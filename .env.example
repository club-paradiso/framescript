# FrameScript Web Studio — deployment configuration.
#
# These belong on the server (Vercel project environment variables), never in
# the client. They are read only by the routes in `api/`, and no value here is
# ever returned to the browser: `/api/capabilities` reports provider and model
# names so the UI can label a source "Ready", and nothing else.
#
# Deliberately not VITE_*: Vite inlines those into the client bundle, which
# would publish the key to every visitor.

# --- Speech to text -----------------------------------------------------------
# On Vercel, no long-lived provider key is required: the deployment's OIDC
# credential is used automatically with Vercel AI Gateway and defaults to
# openai/gpt-4o-transcribe. Override only when you want another Gateway model.
FRAMESCRIPT_GATEWAY_ASR_MODEL=openai/gpt-4o-transcribe

# Optional explicit OpenAI-compatible override. If FRAMESCRIPT_ASR_API_KEY is
# present, these settings take precedence over the Vercel AI Gateway fallback.
FRAMESCRIPT_ASR_PROVIDER=openai-compatible
FRAMESCRIPT_ASR_API_KEY=
FRAMESCRIPT_ASR_ENDPOINT=https://api.openai.com/v1/audio/transcriptions
FRAMESCRIPT_ASR_MODEL=whisper-1

# For local/non-Vercel use of AI Gateway, AI_GATEWAY_API_KEY can be supplied
# instead of Vercel's deployment OIDC credential.
AI_GATEWAY_API_KEY=

# --- Scene understanding ------------------------------------------------------
# On Vercel, no long-lived vision key is required either. FrameScript reuses the
# deployment OIDC credential with the Gateway's OpenAI-compatible multimodal
# chat endpoint. Standard Luna keeps the same vision/structured-output ability
# as its fast route at lower cost; change only the model id when a newer/better
# Gateway model becomes preferable.
FRAMESCRIPT_GATEWAY_VISION_MODEL=openai/gpt-5.6-luna

# Optional explicit provider override. If FRAMESCRIPT_VISION_API_KEY is present,
# these settings take precedence over the Gateway fallback. `anthropic` posts to
# the Messages API; `openai-compatible` posts to a /chat/completions endpoint
# that accepts images.
FRAMESCRIPT_VISION_PROVIDER=anthropic
FRAMESCRIPT_VISION_API_KEY=
FRAMESCRIPT_VISION_ENDPOINT=https://api.anthropic.com/v1/messages
FRAMESCRIPT_VISION_MODEL=
